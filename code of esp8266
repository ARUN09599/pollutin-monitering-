// ==========================================
// 3. HELPER & RGB CONTROL FUNCTIONS
// ==========================================
void setRGB(int red, int green, int blue) {
  if (IS_COMMON_ANODE) {
    analogWrite(RED_PIN, 255 - red);
    analogWrite(GREEN_PIN, 255 - green);
    analogWrite(BLUE_PIN, 255 - blue);
  } else {
    analogWrite(RED_PIN, red);
    analogWrite(GREEN_PIN, green);
    analogWrite(BLUE_PIN, blue);
  }
}

// Volume-Controlled Tone Player
void playCustomTone(int pin, unsigned int frequency, unsigned long duration) {
  if (buzzerVolume <= 0 || alarmMuted) {
    noTone(pin);
    digitalWrite(pin, LOW);
    delay(duration);
    return;
  }

  // Modulate duty cycle according to global volume slider (10% to 100%)
  unsigned long period = 1000000 / frequency;
  unsigned long highTime = (period * buzzerVolume) / 100;
  unsigned long lowTime = period - highTime;
  unsigned long startTime = millis();

  while (millis() - startTime < duration) {
    digitalWrite(pin, HIGH);
    delayMicroseconds(highTime);
    digitalWrite(pin, LOW);
    delayMicroseconds(lowTime);
  }
}

void triggerSuccessGlow() {
  for (int cycle = 0; cycle < 2; cycle++) {
    for (int i = 0; i <= 255; i += 5) {
      setRGB(0, i, 0); 
      delay(8);
    }
    for (int i = 255; i >= 0; i -= 5) {
      setRGB(0, i, 0); 
      delay(8);
    }
  }
  setRGB(0, 255, 0);
}

float computeFeelsLike(float T, float R) {
  if (T < 20.0) return T;
  return -8.784695 + 1.61139411 * T + 2.33854883 * R - 0.14611605 * T * R - 0.01230809 * T * T;
}

void updateComfortStatus() {
  if (humidity < 35.0) comfortStatus = "Too Dry";
  else if (humidity > 70.0) comfortStatus = "Too Humid";
  else if (tempC >= 20.0 && tempC <= 26.0 && humidity >= 40.0 && humidity <= 60.0) comfortStatus = "Optimal";
  else comfortStatus = "Moderate";
}

void initLCD() {
  Wire.begin(SDA_PIN, SCL_PIN);
  byte lcdAddress = 0x00;
  for (byte address = 1; address < 127; address++) {
    Wire.beginTransmission(address);
    if (Wire.endTransmission() == 0) {
      if (address == 0x27 || address == 0x3F) { lcdAddress = address; break; }
    }
  }
  if (lcdAddress != 0x00) {
    lcd = new LiquidCrystal_I2C(lcdAddress, 16, 2);
    lcd->init();
    lcd->backlight();
  }
}

void playStartupAnimation() {
  if (!lcd) return;
  
  lcd->clear();
  lcd->setCursor(0, 0); lcd->print("   Powered by   ");
  lcd->setCursor(0, 1); lcd->print(" @Aruncreation  ");
  delay(2000);

  lcd->clear();
  lcd->setCursor(0, 0); lcd->print(" Project Owner: ");
  lcd->setCursor(0, 1); lcd->print("     Vivek      ");
  delay(2000);
  
  lcd->clear();
}

// =======================================================
// CALIBRATION & MELODY ROUTINE
// =======================================================
void playDBossCalibration() {
  if (lcd) { lcd->clear(); lcd->setCursor(0, 0); lcd->print("Air Calibration"); }

  int melody[] = {
    NOTE_E7, NOTE_G7, NOTE_A7, NOTE_A7, NOTE_G7, NOTE_A7, NOTE_C8, NOTE_B7,
    NOTE_A7, NOTE_G7, NOTE_E7, NOTE_G7, NOTE_A7, NOTE_E7, NOTE_D8, NOTE_C8
  };
  int noteDurations[] = {
    180, 180, 250, 180, 180, 250, 180, 180,
    250, 180, 180, 250, 200, 200, 200, 300
  };

  long sum = 0;
  int totalSteps = sizeof(melody) / sizeof(melody[0]);

  for (int i = 0; i < totalSteps; i++) {
    sum += analogRead(MQ135_PIN);

    if (i % 5 == 0) setRGB(255, 0, 0);         
    else if (i % 5 == 1) setRGB(255, 255, 0);  
    else if (i % 5 == 2) setRGB(0, 255, 0);    
    else if (i % 5 == 3) setRGB(0, 255, 255);  
    else setRGB(255, 0, 255);                  

    playCustomTone(BUZZER_PIN, melody[i], noteDurations[i]);

    if (lcd) {
      lcd->setCursor(0, 1);
      lcd->print("Progress: ");
      lcd->print(((i + 1) * 100) / totalSteps);
      lcd->print("%  ");
    }

    delay(noteDurations[i] * 0.2);
  }

  baselineVal = sum / totalSteps;
  
  if (lcd) { 
    lcd->clear(); 
    lcd->setCursor(0, 0); 
    lcd->print("     Ready      "); 
    delay(1000); 
    lcd->clear(); 
  }
}

