// ==========================================
// 5. SETUP ROUTINE
// ==========================================
void setup() {
  Serial.begin(115200);

  analogWriteRange(255); 

  pinMode(BUZZER_PIN, OUTPUT);
  pinMode(RED_PIN, OUTPUT);
  pinMode(GREEN_PIN, OUTPUT);
  pinMode(BLUE_PIN, OUTPUT);

  digitalWrite(BUZZER_PIN, LOW);
  setRGB(0, 0, 0);

  initLCD();
  playStartupAnimation();

  dht.begin();

  WiFi.begin(ssid1, password1);
  int attempt = 0;
  while (WiFi.status() != WL_CONNECTED && attempt < 10) { delay(500); attempt++; }

  if (WiFi.status() != WL_CONNECTED) {
    WiFi.begin(ssid2, password2);
    attempt = 0;
    while (WiFi.status() != WL_CONNECTED && attempt < 10) { delay(500); attempt++; }
  }

  playDBossCalibration();
  triggerSuccessGlow();

  server.on("/", handleRoot);

  server.on("/api/data", []() {
    String json = "{\"ppm\":" + String(estimatedPPM) + 
                  ",\"temp\":" + String(tempC, 1) + 
                  ",\"hum\":" + String(humidity, 1) + 
                  ",\"status\":\"" + pollutionStatus + "\"}";
    server.send(200, "application/json", json);
  });

  // Web API endpoint to adjust volume slider dynamically
  server.on("/setVolume", []() {
    if (server.hasArg("val")) {
      buzzerVolume = server.arg("val").toInt();
      if (buzzerVolume < 0) buzzerVolume = 0;
      if (buzzerVolume > 100) buzzerVolume = 100;
    }
    server.send(200, "text/plain", "OK");
  });

  server.on("/toggleMute", []() {
    alarmMuted = !alarmMuted;
    noTone(BUZZER_PIN);
    digitalWrite(BUZZER_PIN, LOW);
    server.send(200, "text/plain", "OK");
  });

  server.on("/testBuzzer", []() {
    playCustomTone(BUZZER_PIN, 2700, 300);
    server.send(200, "text/plain", "OK");
  });

  server.on("/recalibrate", []() {
    playDBossCalibration();
    server.send(200, "text/plain", "OK");
  });

  server.begin();
}

// ==========================================
// 6. MAIN LOOP
// ==========================================
void loop() {
  server.handleClient();

  globalSensorVal = analogRead(MQ135_PIN);
  int pollutionDelta = globalSensorVal - baselineVal;
  if (pollutionDelta < 0) pollutionDelta = 0;
  estimatedPPM = map(pollutionDelta, 0, 400, 0, 500);

  if (millis() - lastDHTReadTime >= 2500) {
    lastDHTReadTime = millis();
    float readH = dht.readHumidity();
    float readT = dht.readTemperature();
    
    if (isnan(readH) || isnan(readT)) {
      Serial.println("ERROR: Failed to read from DHT sensor! Check wiring on pin D4.");
      tempC = 0.0;
      humidity = 0.0;
    } else {
      humidity = readH; 
      tempC = readT;
      feelsLikeC = computeFeelsLike(tempC, humidity);
      updateComfortStatus();
    }
  }

  if (lcd && (millis() - lastLCDUpdate > 3000)) {
    lcdDisplayPage = (lcdDisplayPage + 1) % 4;
    lastLCDUpdate = millis();
    lcd->clear();
  }

  if (lcd) {
    if (lcdDisplayPage == 0) {
      lcd->setCursor(0, 0); lcd->print("PPM:"); lcd->print(estimatedPPM);
      lcd->setCursor(0, 1); lcd->print("Status: "); lcd->print(pollutionStatus);
    } else if (lcdDisplayPage == 1) {
      lcd->setCursor(0, 0); lcd->print("Temp: "); lcd->print(tempC, 1); lcd->print(" C");
      lcd->setCursor(0, 1); lcd->print("Hum:  "); lcd->print(humidity, 1); lcd->print(" %");
    } else if (lcdDisplayPage == 2) {
      lcd->setCursor(0, 0); lcd->print("Feels: "); lcd->print(feelsLikeC, 1); lcd->print(" C");
      lcd->setCursor(0, 1); lcd->print("Comf: "); lcd->print(comfortStatus);
    } else {
      lcd->setCursor(0, 0); lcd->print("IP Address:");
      lcd->setCursor(0, 1); lcd->print(WiFi.localIP());
    }
  }

  // High Pollution Alarm logic affected by Volume Adjuster
  if (estimatedPPM < 150) {
    pollutionStatus = "Normal Air"; 
    setRGB(0, 255, 0); 
    noTone(BUZZER_PIN);
    digitalWrite(BUZZER_PIN, LOW);
  } else if (estimatedPPM < alarmPPMThreshold) {
    pollutionStatus = "Moderate"; 
    setRGB(255, 255, 0); 
    noTone(BUZZER_PIN);
    digitalWrite(BUZZER_PIN, LOW);
  } else {
    pollutionStatus = "High Pollution!"; 
    setRGB(255, 0, 0); 
    if (!alarmMuted && millis() - lastBuzzerToggle >= buzzerToneSpeed) {
      lastBuzzerToggle = millis(); 
      buzzerState = !buzzerState;
      if (buzzerState) {
        playCustomTone(BUZZER_PIN, 2700, 100);
      } else {
        digitalWrite(BUZZER_PIN, LOW);
      }
    }
  }

  delay(50);
}
